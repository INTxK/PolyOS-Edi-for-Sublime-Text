{
  /* 
    ---
    Author: Muhammad Mustafa Monowar
    Updated: 2026-08-09
    Target: Sublime Text
    Version: v3.3.5
    ---
    PolyOS First-Use Preferences

    This file mirrors the shared Packages/PolyOS-Edi-for-Sublime-Text/
    Preferences.sublime-settings and is applied into Packages/User/ by the
    package's auto-sync plugin on first install / version upgrade.

    Because Packages/User/Preferences.sublime-settings wins over every
    package's own Preferences.sublime-settings, writing these keys into
    User/ guarantees the PolyOS look even on machines that already carry
    stock preferences (theme "auto", Mariana scheme, ...). The plugin MERGES
    into the existing file, so any unrelated user settings are preserved.

    Keys defined here must NOT be redefined in the profile's platform files
    (Preferences (OSX|Windows).sublime-settings), otherwise the platform
    value would be overridden.
  */

  "font_size": 16,
  "font_face": "JetBrains Mono",
  // Cross-platform font options. Windows adds `directwrite` and
  // `subpixel_antialias` via the profile's `Preferences (Windows).sublime-settings`.
  "font_options": [
    "dlig",
    "calt"
  ],

  "theme": "PolyOS Editor Dark.sublime-theme",
  "color_scheme": "Packages/PolyOS-Edi-for-Sublime-Text/polymark.sublime-color-scheme",
  "default_syntax": "Packages/PolyOS-Edi-for-Sublime-Text/polymark.sublime-syntax",

  "ignored_packages": [
    "Vintage"
  ],

  "save_on_focus_lost": true,
  "highlight_line": false,

  // Caret Config (Block caret active globally)
  "block_caret": true,
  "caret_style": "smooth",

  "word_wrap": true,
  "indent_subsequent_lines": true,
  "line_padding_top": 0,
  "line_padding_bottom": 0,

  "trim_trailing_white_space_on_save": false,
  "index_files": false,

  // Code Mode Auto-Complete
  "auto_complete": true,
  "tab_completion": false,
  "auto_complete_commit_on_tab": false,
  "auto_complete_selector": "meta.tag, source, text.html, text.plain",
}
